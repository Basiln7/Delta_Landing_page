# ── Admin sign-in: the OWNER account ──
# This account is the owner: a super admin who can't be removed and adds everyone else in
# Admin → Users (each person then chooses their own password from a one-time link).
# Development: these demo values work out of the box. Production REFUSES them (and any
# ADMIN_PASSWORD under 12 characters). Prefer ADMIN_PASSWORD_HASH in production:
#   npm run hash-password   → prints ADMIN_PASSWORD_HASH=scrypt:...  (then remove ADMIN_PASSWORD)
ADMIN_EMAIL=admin@delta.academy
ADMIN_PASSWORD=delta-admin-2026
ADMIN_PASSWORD_HASH=

# Signs the admin session cookie. REQUIRED in production: 32+ random characters, never this file's value.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Left empty in development, a random key is generated on each server start (you'll be signed out on restart).
SESSION_SECRET=

# ── Razorpay (https://dashboard.razorpay.com → Account & Settings → API Keys) ──
# Leave blank to keep the demo checkout. Use rzp_test_… keys while testing, rzp_live_… in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Account & Settings → Webhooks → your endpoint's secret
# Endpoint URL: https://<your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Without Razorpay keys, development uses a demo checkout that marks orders PAID with no payment.
# Production refuses that unless you set this deliberately (e.g. for a public demo site).
ALLOW_DEMO_CHECKOUT=

# ── Database ──
# Set MONGODB_URI to use MongoDB; leave it blank to use the local JSON file (storage/db.json).
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=delta_markets

# ── Email (SMTP) ──
# SMTP host/login are set in Admin → Email (stored encrypted in the database), not here.
# Key that encrypts stored credentials: 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, development derives one from SESSION_SECRET (set a real key in production).
CREDENTIALS_ENCRYPTION_KEY=
# Public URL of the site — used for links inside emails (default http://localhost:3000)
NEXT_PUBLIC_SITE_URL=
